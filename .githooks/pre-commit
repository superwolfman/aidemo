#!/bin/sh
# Pre-commit hook: prevent broken code from being committed.
# Enable with: git config core.hooksPath .githooks

set -e

changed=$(git diff --cached --name-only --diff-filter=ACM || true)

echo "[pre-commit] syntax checking changed JS files..."
changed_js=$(echo "$changed" | grep -E '\.(js|mjs|cjs)$' || true)
if [ -n "$changed_js" ]; then
  for f in $changed_js; do
    if [ -f "$f" ]; then
      node --check "$f"
      echo "  OK  $f"
    fi
  done
fi

if echo "$changed" | grep -qE '^server/src/'; then
  echo "[pre-commit] server source changed, running server tests..."
  cd server && npm test && cd ..
fi

if echo "$changed" | grep -qE '^client/src/'; then
  echo "[pre-commit] client source changed, running lint / typecheck / build..."
  npm run lint --workspace client
  npm run typecheck --workspace client
  npm run build --workspace client
fi

echo "[pre-commit] all checks passed"
