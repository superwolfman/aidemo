{
  "name": "ai-architecture-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI Architecture Copilot MVP with multi-session chat, skill runtime, tool calling, RAG, human-in-the-loop approvals and agent tracing.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "node scripts/dev.mjs",
    "mongo": ".local/mongodb/bin/mongod --dbpath .local/mongodb-data --bind_ip 127.0.0.1 --port 27017",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspace client",
    "typecheck": "npm run typecheck --workspace client",
    "test:server": "npm run test --workspace server",
    "verify": "node scripts/verify-ai-workflow.mjs",
    "vector:health": "node scripts/atlas-vector-health.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
