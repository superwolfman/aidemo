{
  "name": "employee-enablement-ai-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise employee enablement AI platform demo with React, Node.js, MongoDB, RAG, WeCom assistant, Spec Coding and AI Skill orchestration.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev": "node scripts/dev.mjs",
    "mongo": ".local/mongodb/bin/mongod --dbpath .local/mongodb-data --bind_ip 127.0.0.1 --port 27017",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client"
  },
  "engines": {
    "node": ">=20"
  }
}
