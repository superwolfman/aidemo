# 仅允许本地开发临时使用。
# MongoDB 不可用时是否降级到本地 FileStore。
# 生产环境必须为 false 或不设置。
ALLOW_FILE_STORE_FALLBACK=false
PORT=4000
HOST=127.0.0.1
JWT_SECRET=change-me-for-local-demo
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local password login is development-only. Override these values in a private
# untracked .env; production should use Cloudflare Access and disable both flags.
PASSWORD_LOGIN_ENABLED=true
# 新前端使用 HttpOnly Cookie；仅兼容旧脚本时才临时开启 Bearer。
LEGACY_BEARER_ENABLED=false
# 默认不创建任何共享管理员。仅在私有 .env 中临时开启，并注入独立账号；
# 创建完成后立即恢复 false。禁止把邮箱或密码写回模板、README 或 Git。
SEED_DEMO_ADMIN=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=false

# Cloudflare Access origin identity (normally disabled for local development).
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional defence-in-depth exact-email allowlist. The Access policy remains primary.
CF_ACCESS_ALLOWED_EMAILS=
DEMO_AUTO_PROVISION=false
DEMO_TENANT_ID=tenant-interview-demo
DEMO_ALLOWED_KNOWLEDGE_SCOPES=copilot,architecture,frontend,ai-native,standards,frontend-observability,engineering-governance,performance,im,sdk,investment-research,research-workbench,company-filings,industry-research,financial-analysis,research-report-generation,citation-compliance,customer-service,customer-service-knowledge,answer-generation,knowledge-correction,conversation-operations,service-quality
DEMO_ACCESS_EXPIRES_AT=
DEMO_RUN_LIMIT_PER_HOUR=20

# MCP stdio service identity. Production must inject an explicit tenant.
MCP_TENANT_ID=tenant-demo
MCP_ALLOWED_KNOWLEDGE_SCOPES=*

# MongoDB local document store, used only when RAG_BACKEND=local-hash.
MONGODB_URI=mongodb://127.0.0.1:27017
# 强制环境隔离：development 必须使用 _dev 后缀；不要与线上 aidemo_prod 共用。
MONGODB_DB_NAME=aidemo_dev
# 使用本地无认证 Mongo 时留空；连接 Atlas 开发库时设置为独立的 *_dev_app 用户。
MONGODB_EXPECTED_USERNAME=

# MongoDB Atlas Vector Search, used when RAG_BACKEND=mongodb-atlas.
# Fill this with your real Atlas URI in .env. Do not commit real credentials.
MONGODB_ATLAS_URI=

# LLM Provider.
# mock: deterministic local runtime.
# openai / deepseek / dashscope / openai-compatible: live provider via chat.completions.
#LLM_PROVIDER=mock
#LLM_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#DASHSCOPE_API_KEY=
#LLM_BASE_URL=
#LLM_MODEL=
# Optional ordered model ids. Runtime settings in MongoDB take precedence after initialization.
#LLM_FALLBACK_MODELS=qwen3.7-plus,qwen-plus-2025-07-28

# DeepSeek example:
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# OpenAI-compatible example:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=your-model

# RAG backend contract.
# local-hash: offline fallback.
# mongodb-atlas: real MongoDB Atlas Vector Search with chunks.embedding.
RAG_BACKEND=mongodb-atlas
RAG_VECTOR_INDEX=chunks_vector_index_v2
RAG_VECTOR_PATH=embedding
RAG_VECTOR_DIMENSIONS=1024
# Atlas 原始向量相关度门槛；低于门槛的候选不会进入 LLM 上下文。
# 可选紧急覆盖。正常阈值由 npm run rag:evaluate:apply 基于当前环境 Golden Dataset 校准并持久化。
# RAG_MIN_VECTOR_SCORE=0.8
# Set true only when connected to MongoDB Atlas and you want the app to request index creation.
RAG_CREATE_VECTOR_INDEX=false
