PORT=4000
HOST=127.0.0.1
JWT_SECRET=change-me-for-local-demo
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB is the production/default data layer.
# If MongoDB is unavailable, the server falls back to ./server/data/demo-db.json
# so the local demo can still run on a clean laptop.
MONGODB_URI=mongodb://127.0.0.1:27017/growth_ai_assistant

# LLM Provider.
# mock: deterministic local runtime.
# openai / deepseek / dashscope / openai-compatible: live provider via chat.completions.
#LLM_PROVIDER=mock
#LLM_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#DASHSCOPE_API_KEY=
#LLM_BASE_URL=
#LLM_MODEL=

# DeepSeek example:
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# OpenAI-compatible example:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=your-model

# RAG backend contract.
# local-hash works offline.
# mongodb-atlas uses MongoDB Atlas Vector Search with the chunks.embedding field.
RAG_BACKEND=local-hash
# RAG_BACKEND=mongodb-atlas
RAG_VECTOR_INDEX=chunks_vector_index
RAG_VECTOR_PATH=embedding
RAG_VECTOR_DIMENSIONS=96
# Set true only when connected to MongoDB Atlas and you want the app to request index creation.
RAG_CREATE_VECTOR_INDEX=false
