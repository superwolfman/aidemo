# aidemo 前端镜像（Vite build → nginx 静态托管 + /api 反代到后端）
# build 阶段注入 VITE_API_BASE（前端 API 地址，client/src/api/client.ts:1）
# 生产：VITE_API_BASE 与公网域名同源，例如 https://app.agentdelivery.asia。
FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_API_BASE
ARG APP_ENV=production
ARG APP_COMMIT=unknown
ARG APP_BRANCH=unknown
ARG APP_VERSION=unknown
ARG APP_DIRTY=false
ARG APP_BUILD_TIME
ENV VITE_API_BASE=$VITE_API_BASE
ENV APP_ENV=$APP_ENV APP_COMMIT=$APP_COMMIT APP_BRANCH=$APP_BRANCH APP_VERSION=$APP_VERSION APP_DIRTY=$APP_DIRTY APP_BUILD_TIME=$APP_BUILD_TIME
COPY package.json package-lock.json ./
COPY client/package.json ./client/
COPY server/package.json ./server/
# vite 属 devDependencies，需装 dev 才能 build
RUN npm ci || (echo 'npm ci failed, retry with registry.npmjs.org...' && npm config set registry https://registry.npmjs.org/ && npm ci)
COPY client/ ./client/
COPY server/ ./server/
COPY release-info.json ./release-info.json
RUN npm run build --workspace client

FROM nginx:alpine
# 前端静态产物
COPY --from=build /app/client/dist /usr/share/nginx/html
# nginx 配置（反代 + SSE 透传）
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
