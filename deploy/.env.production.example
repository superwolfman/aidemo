# ============================================================
# aidemo 生产环境变量模板
# 用法：cp .env.production.example .env.production，填入真实值后启用
# 切勿提交真实 .env.production 到 git（.gitignore 已排除 .env）
# ============================================================

# ---- 运行时 ----
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ---- 安全：JWT 密钥（必改！生产不可用 local-demo-secret）----
# 生成：openssl rand -hex 32
JWT_SECRET=replace-with-32-bytes-random

# ---- CORS：前端实际访问地址（IP 或域名，含协议，无尾斜杠）----
# 与 VITE_API_BASE 保持同源即可，不触发跨域
CLIENT_ORIGIN=http://YOUR_ECS_PUBLIC_IP
CLIENT_ORIGINS=http://YOUR_ECS_PUBLIC_IP

# ---- 文件存储降级（生产必须 false）----
ALLOW_FILE_STORE_FALLBACK=false

# ---- MongoDB Atlas（向量库 + 业务数据，已在云上）----
# 在 Atlas 控制台 Network Access 加入 ECS 公网 IP（或临时 0.0.0.0/0）
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ---- LLM Provider（DashScope，国内阿里云，速度好）----
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-dashscope-key
LLM_MODEL=qwen-flash-2025-07-28
# 可选：超时（毫秒），生产建议 60s
LLM_TIMEOUT_MS=60000

# ---- Embedding（DashScope text-embedding-v3，留空则复用 DASHSCOPE_API_KEY）----
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# ---- RAG：Atlas Vector Search 主链路 ----
RAG_BACKEND=mongodb-atlas
RAG_VECTOR_INDEX=chunks_vector_index_v2
RAG_VECTOR_PATH=embedding
RAG_VECTOR_DIMENSIONS=1024
# 生产已有索引则 false；首次建索引可临时 true
RAG_CREATE_VECTOR_INDEX=false

# ---- 可选：MCP（如不启用 MCP 服务可留空）----
MCP_TENANT_ID=tenant-demo
MCP_ALLOWED_KNOWLEDGE_SCOPES=*
