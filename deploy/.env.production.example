# ============================================================
# aidemo 生产环境变量模板
# 用法：cp .env.production.example .env.production，填入真实值后启用
# 切勿提交真实 .env.production 到 git（.gitignore 已排除 .env）
# ============================================================

# ---- 运行时 ----
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ---- 安全：JWT 密钥（必改！生产不可用 local-demo-secret）----
# 生成：openssl rand -hex 32
JWT_SECRET=replace-with-32-bytes-random
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=__Host-aidemo_session
SESSION_COOKIE_SECURE=true

# ---- HTTPS 公网域名 ----
# 有自有域名时优先使用自有域名；无域名可使用 <公网IP>.sslip.io。
PUBLIC_HOST=8-217-153-138.sslip.io
EXPECTED_PUBLIC_IP=8.217.153.138

# ---- 公网演示认证：Cloudflare Access 是唯一外层身份入口 ----
CF_ACCESS_ENABLED=true
# 示例：your-team.cloudflareaccess.com（不要带 https://）
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# Cloudflare Zero Trust > Access > Applications > 当前应用 > AUD
CF_ACCESS_AUD=replace-with-access-application-aud
# 可选二次精确邮箱白名单；留空表示完全信任已验证的 Access Policy
CF_ACCESS_ALLOWED_EMAILS=

# Access 首次通过后，在现有 users 集合自动创建最小权限 demo_viewer
DEMO_AUTO_PROVISION=true
DEMO_TENANT_ID=tenant-interview-demo
DEMO_ALLOWED_KNOWLEDGE_SCOPES=copilot,architecture,frontend,ai-native,standards
# 可选硬截止时间；到期后即使 Access 仍放行，应用也拒绝会话
DEMO_ACCESS_EXPIRES_AT=
DEMO_RUN_LIMIT_PER_HOUR=20

# 公网环境禁止密码入口和固定管理员种子
PASSWORD_LOGIN_ENABLED=false
LEGACY_BEARER_ENABLED=false
SEED_DEMO_ADMIN=false

# ---- CORS：前端实际访问地址（IP 或域名，含协议，无尾斜杠）----
# 与 VITE_API_BASE 保持同源即可，不触发跨域
CLIENT_ORIGIN=https://demo.example.com
CLIENT_ORIGINS=https://demo.example.com

# ---- 文件存储降级（生产必须 false）----
ALLOW_FILE_STORE_FALLBACK=false

# ---- MongoDB Atlas（向量库 + 业务数据，已在云上）----
# 在 Atlas 控制台 Network Access 加入 ECS 公网 IP（或临时 0.0.0.0/0）
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 应与连接串中的用户名一致。生产建议命名 aidemo_prod_app；开发使用 aidemo_dev_app。
MONGODB_EXPECTED_USERNAME=aidemo_prod_app
# 生产必须显式配置且以 _prod 结尾；服务端会写环境标记并拒绝 Dev/Prod 串库。
MONGODB_DB_NAME=aidemo_prod
MONGODB_LEGACY_DB_NAME=growth_ai_assistant

# ---- LLM Provider（DashScope，国内阿里云，速度好）----
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-dashscope-key
LLM_MODEL=qwen-flash-2025-07-28
# 可选：超时（毫秒），生产建议 60s
LLM_TIMEOUT_MS=60000

# ---- Embedding（DashScope text-embedding-v3，留空则复用 DASHSCOPE_API_KEY）----
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# ---- RAG：Atlas Vector Search 主链路 ----
RAG_BACKEND=mongodb-atlas
RAG_VECTOR_INDEX=chunks_vector_index_v2
RAG_VECTOR_PATH=embedding
RAG_VECTOR_DIMENSIONS=1024
# 生产已有索引则 false；首次建索引可临时 true
RAG_CREATE_VECTOR_INDEX=false

# ---- 可选：MCP（如不启用 MCP 服务可留空）----
MCP_TENANT_ID=tenant-demo
MCP_ALLOWED_KNOWLEDGE_SCOPES=*
